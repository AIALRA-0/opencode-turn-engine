  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) glob 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "followSymlinks": {
      "description": "Follow symlinks while searching. Defaults to false.",
      "type": "boolean",
    },
    "ignore": {
      "description": "Additional glob patterns to exclude from the result set.",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "maxResults": {
      "description": "Maximum number of results to return. Defaults to 100 and is capped at 10000.",
      "type": "number",
    },
    "path": {
      "description": "The directory to search in. If not specified, the current working directory will be used. IMPORTANT: Omit this field to use the default directory. DO NOT enter "undefined" or "null" - simply omit it for the default behavior. Must be a valid directory path if provided.",
      "type": "string",
    },
    "pattern": {
      "description": "The glob pattern to match files against",
      "type": "string",
    },
    "protectedPolicy": {
      "description": "How protected metadata paths such as .git, .agents, and .codex are handled. Defaults to hide.",
      "enum": [
        "hide",
        "show_refused",
      ],
      "type": "string",
    },
    "showHidden": {
      "description": "Whether hidden dotfiles are included. Defaults to true for backwards compatibility.",
      "type": "boolean",
    },
    "timeoutMs": {
      "description": "Optional ripgrep timeout in milliseconds.",
      "type": "number",
    },
  },
  "required": [
    "pattern",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) grep 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contextLines": {
      "description": "Number of surrounding context lines to show around each match. Defaults to 0.",
      "type": "number",
    },
    "followSymlinks": {
      "description": "Follow symlinks while searching. Defaults to false.",
      "type": "boolean",
    },
    "ignore": {
      "description": "Additional glob patterns to exclude from the search.",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "include": {
      "description": "File pattern to include in the search (e.g. "*.js", "*.{ts,tsx}")",
      "type": "string",
    },
    "maxLineChars": {
      "description": "Maximum characters shown for each matched line. Defaults to 2000.",
      "type": "number",
    },
    "maxMatches": {
      "description": "Maximum number of matches to return. Defaults to 100 and is capped at 10000.",
      "type": "number",
    },
    "path": {
      "description": "The directory to search in. Defaults to the current working directory.",
      "type": "string",
    },
    "pattern": {
      "description": "The regex pattern to search for in file contents",
      "type": "string",
    },
    "protectedPolicy": {
      "description": "How protected metadata paths such as .git, .agents, and .codex are handled. Defaults to hide.",
      "enum": [
        "hide",
        "show_refused",
      ],
      "type": "string",
    },
    "showHidden": {
      "description": "Whether hidden dotfiles are included. Defaults to true for backwards compatibility.",
      "type": "boolean",
    },
    "timeoutMs": {
      "description": "Optional ripgrep timeout in milliseconds.",
      "type": "number",
    },
  },
  "required": [
    "pattern",
  ],
  "type": "object",
}
`;

