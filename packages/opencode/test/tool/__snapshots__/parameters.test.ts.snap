exports[`tool parameters JSON Schema (wire shape) await_process 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "description": "Clear, concise description of why this process is being awaited",
      "type": "string",
    },
    "poll_interval_ms": {
      "description": "How often to check process status. Defaults to 250ms and is clamped to a safe range.",
      "type": "number",
    },
    "process_id": {
      "description": "The running process_id returned by the bash tool when yield_time_ms elapsed",
      "type": "string",
    },
    "timeout_ms": {
      "description": "Maximum time to wait for the process to reach a terminal state, capped by this turn's engineering controls.",
      "type": "number",
    },
  },
  "required": [
    "process_id",
    "description",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) bash 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "command": {
      "description": "The command to execute",
      "type": "string",
    },
    "description": {
      "description": 
"Clear, concise description of what this command does in 5-10 words. Examples:
Input: ls
Output: Lists files in current directory

Input: git status
Output: Shows working tree status

Input: npm install
Output: Installs package dependencies

Input: mkdir foo
Output: Creates directory 'foo'"
,
      "type": "string",
    },
    "timeout": {
      "description": "Optional timeout in milliseconds",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "workdir": {
      "description": "The working directory to run the command in. Defaults to the current directory. Use this instead of 'cd' commands.",
      "type": "string",
    },
    "yield_time_ms": {
      "description": "Optional foreground wait in milliseconds before returning a still-running process_id. Defaults to 10000ms and is clamped to 250-30000ms.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
  },
  "required": [
    "command",
    "description",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) cleanup_processes 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "description": "Clear, concise description of why these background processes are being cleaned.",
      "type": "string",
    },
    "environment_id": {
      "description": "Optional environment id filter.",
      "type": "string",
    },
    "include_finished": {
      "description": "When false, do not clean already-finished process records. Defaults to true.",
      "type": "boolean",
    },
    "include_running": {
      "description": "When true, terminate still-running processes selected by the filters before marking them cleaned.",
      "type": "boolean",
    },
    "process_id": {
      "description": "One process_id to clean up. Omit to clean by filters.",
      "type": "string",
    },
    "process_ids": {
      "description": "Multiple process_id values to clean up.",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "statuses": {
      "description": "Optional process statuses to clean. Defaults to all finished statuses unless include_running is true.",
      "items": {
        "enum": [
          "running",
          "completed",
          "failed",
          "timeout",
          "aborted",
        ],
        "type": "string",
      },
      "type": "array",
    },
    "turn_id": {
      "description": "Optional turn id filter. Defaults to the current turn when available.",
      "type": "string",
    },
  },
  "required": [
    "description",
  ],
  "type": "object",
}
`;

